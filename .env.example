# REST en frontend siempre entra por /api.
VITE_API_URL=/api

# En desarrollo, Vite decide a que backend proxyear /api.
# Local:
# VITE_DEV_API_PROXY_TARGET=http://localhost:3000
# Railway:
# VITE_DEV_API_PROXY_TARGET=https://logickids-backend-sena-production.up.railway.app

# Los sockets no pasan por Vercel ni por Vite proxy.
VITE_SOCKET_URL=https://logickids-backend-sena-production.up.railway.app
